# ============================================
# AgenticWhats — environment configuration
# This file lives at the project root and is loaded by the backend.
# NEVER commit real secrets to git.
# ============================================

APP_ENV=development

# Database: SQLite for local dev (no install needed).
# For PostgreSQL: postgresql+psycopg2://user:password@localhost:5432/agenticwhats
DATABASE_URL=sqlite:///./agenticwhats.db

# Redis (background jobs; not required for local dev)
REDIS_URL=redis://localhost:6379/0

# LLM: "mock" = offline deterministic agent (no key needed).
# Set LLM_PROVIDER=openai + your key to enable the full agentic LLM path.
# Works with any OpenAI-compatible endpoint (OpenAI, Groq, OpenRouter, Ollama...).
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Embeddings: "mock" = local deterministic embeddings (offline).
# Set to openai for production-quality retrieval.
EMBEDDING_PROVIDER=mock
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=384

# WhatsApp Cloud API (official platform).
# Leave WHATSAPP_ACCESS_TOKEN empty to run the platform in MOCK mode
# (messages are logged, webhook simulator works end-to-end).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=agenticwhats-verify
WHATSAPP_APP_SECRET=

# Auth
JWT_SECRET=dev-only-secret-change-me-9f8e7d6c5b4a
JWT_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:3000

# Demo tenant seed credentials
DEMO_OWNER_EMAIL=owner@demo.com
DEMO_OWNER_PASSWORD=demo1234
